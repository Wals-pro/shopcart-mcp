{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.Wals-pro/shopcart-mcp",
  "title": "ShopCart MCP",
  "description": "Search Shopify, WooCommerce & Amazon stores, browse sale collections, check shipping & return policies, inspect variants, and create cart links.",
  "version": "0.4.0",
  "websiteUrl": "https://shopcart.wals.pro",
  "repository": {
    "url": "https://github.com/Wals-pro/shopcart-mcp",
    "source": "github"
  },
  "icons": [
    {
      "src": "https://shopcart.wals.pro/apple-touch-icon.png",
      "mimeType": "image/png",
      "sizes": [
        "180x180"
      ]
    },
    {
      "src": "https://shopcart.wals.pro/icon-512.png",
      "mimeType": "image/png",
      "sizes": [
        "512x512"
      ]
    }
  ],
  "packages": [
    {
      "registryType": "npm",
      "identifier": "shopcart-mcp",
      "version": "0.4.0",
      "transport": {
        "type": "stdio"
      }
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://shopcart.wals.pro/mcp"
    }
  ]
