# Required for hosted server
PORT=8080
APP_ORIGIN=http://localhost:8080

# Storage: "firestore" (default in production) or "memory" (local dev without GCP)
STORAGE_BACKEND=memory
GOOGLE_CLOUD_PROJECT=walspro-shopcart-mcp

# Promo & quotas
FREE_DAILY_LIMIT=20
PRO_DAILY_LIMIT=500
PROMO_FREE_PRO_UNTIL=2026-12-06T23:59:59+01:00
PROMO_TRIAL_END=2026-12-07T00:00:00+01:00

# Optional Stripe Billing (graceful degradation if empty)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=

# Cookie signing secret (auto-generated ephemerally if empty; set persistent secret in production!)
SESSION_SECRET=

# Optional zero-redeploy directory verification tokens (return 404 when empty)
OPENAI_APPS_CHALLENGE=
MCP_REGISTRY_AUTH=

# Optional IndexNow verification key (8-128 hex/alphanumeric chars; serves GET /<INDEXNOW_KEY>.txt)
INDEXNOW_KEY=

# Optional zero-redeploy demo video URLs (YouTube, Vimeo, TikTok, or direct .mp4/.webm)
DEMO_VIDEO_URL=
DEMO_VIDEO_URL_DE=
DEMO_VIDEO_URL_EN=

# Passwordless Email OTP + Magic Link SMTP config
# Format: smtps://user:pass@smtp.example.com:465 or smtp://user:pass@smtp.example.com:587
SMTP_URL=
SMTP_SENDER_EMAIL=support@notify.wals.pro
SMTP_SENDER_NAME=ShopCart by wals.pro

# Optional directory-reviewer deterministic test account (disabled when empty)
REVIEWER_TEST_EMAIL=
REVIEWER_TEST_CODE=
