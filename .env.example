# Required for hosted server
PORT=8080
APP_ORIGIN=http://localhost:8080

# Storage: "firestore" (default in production) or "memory" (local dev without GCP)
STORAGE_BACKEND=memory
GOOGLE_CLOUD_PROJECT=walspro-shopcart-mcp

# Promo & quotas
FREE_DAILY_LIMIT=20
PRO_DAILY_LIMIT=500
PROMO_FREE_PRO_UNTIL=2026-12-06T23:59:59+01:00
PROMO_TRIAL_END=2026-12-07T00:00:00+01:00

# Optional Stripe Billing (graceful degradation if empty)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=

# Cookie signing secret (auto-generated ephemerally if empty; set persistent secret in production!)
SESSION_SECRET=

# Optional zero-redeploy directory verification tokens (return 404 when empty)
OPENAI_APPS_CHALLENGE=
MCP_REGISTRY_AUTH=

# Optional IndexNow verification key (8-128 hex/alphanumeric chars; serves GET /<INDEXNOW_KEY>.txt)
INDEXNOW_KEY=

# Optional Google Analytics 4 Measurement ID (format: G-XXXXXXXXXX; zero-pre-consent EU/AT DSGVO & TKG 2021)
GA4_MEASUREMENT_ID=

# Optional zero-redeploy demo video URLs (YouTube, Vimeo, TikTok, or direct .mp4/.webm)
# Hosted GCS hero videos (v2 with Frame-0 cover + attached_pic) and poster images:
#   DEMO_VIDEO_URL_DE=https://storage.googleapis.com/walspro-shopcart-media/videos/01-snocks-hero-16x9-de-v2.mp4
#   DEMO_VIDEO_URL_EN=https://storage.googleapis.com/walspro-shopcart-media/videos/04-allbirds-hero-16x9-en-v2.mp4
#   DEMO_VIDEO_POSTER_DE=https://storage.googleapis.com/walspro-shopcart-media/videos/01-snocks-hero-16x9-de-poster.jpg
#   DEMO_VIDEO_POSTER_EN=https://storage.googleapis.com/walspro-shopcart-media/videos/04-allbirds-hero-16x9-en-poster.jpg
DEMO_VIDEO_URL=
DEMO_VIDEO_URL_DE=
DEMO_VIDEO_URL_EN=
DEMO_VIDEO_POSTER=
DEMO_VIDEO_POSTER_DE=
DEMO_VIDEO_POSTER_EN=

# Passwordless Email OTP + Magic Link SMTP config
# Format: smtps://user:pass@smtp.example.com:465 or smtp://user:pass@smtp.example.com:587
SMTP_URL=
SMTP_SENDER_EMAIL=support@notify.wals.pro
SMTP_SENDER_NAME=ShopCart by wals.pro

# Optional directory-reviewer deterministic test account (disabled when empty)
REVIEWER_TEST_EMAIL=
REVIEWER_TEST_CODE=

# Universal UTM Attribution (enabled by default in hosted HTTP mode; set SHOPCART_DISABLE_UTM=1 to opt out)
SHOPCART_DISABLE_UTM=0
ATTRIBUTION_UTM_SOURCE=shopcart.wals.pro
ATTRIBUTION_UTM_MEDIUM=ai_mcp
ATTRIBUTION_UTM_CAMPAIGN=shopcart_mcp

# Optional Amazon PartnerNet / Associates & live catalog providers (Stage 1 ASIN cart links work without any keys; never commit real production tags)
# Single fallback tag, per-country env vars, or per-marketplace JSON map, e.g. {"de":"yourtag-21","com":"yourtag-20","co.uk":"yourtag-21"}
AMAZON_ASSOCIATE_TAG=
AMAZON_ASSOCIATE_TAG_DE=
AMAZON_ASSOCIATE_TAG_US=
AMAZON_ASSOCIATE_TAG_UK=
AMAZON_ASSOCIATE_TAGS_JSON=
AMAZON_PAAPI_ACCESS_KEY=
AMAZON_PAAPI_SECRET_KEY=
KEEPA_API_KEY=

# Optional domain-specific partner/affiliate rules as JSON array (Zod-validated; https-only {encoded_url} templates)
# Example: [{"domain":"snocks.com","ref":"partner123","discount":"WELCOME10"},{"domain":"*.example.de","network":"awin","deeplink_template":"https://www.awin1.com/cread.php?awinmid=12345&awinaffid=67890&ued={encoded_url}"}]
AFFILIATE_RULES_JSON=

# Optional Awin Product Datafeed & Publisher Promotions API (degrades gracefully when empty; enables cross-store deal, voucher & EAN search)
AWIN_API_TOKEN=
AWIN_PUBLISHER_ID=
# Optional comma-separated Awin Feed IDs (leave empty to auto-discover joined feeds)
AWIN_FEED_IDS=
AWIN_FEED_TTL_SECONDS=3600

# Optional Price Comparison & Hot Deals monetization / Tier-A provider hooks (never commit real keys)
# Optional HTTPS Sovrn Commerce deeplink wrapper containing {encoded_url} (strictly restricted to redirect.viglink.com or sovrn.co)
# Example: https://redirect.viglink.com/?key=YOUR_KEY&u={encoded_url}
SOVRN_COMMERCE_DEEPLINK_TEMPLATE=
# Optional reserved slot for future live Kelkoo Shopping API integration (surfaced as configured/not_configured only)
KELKOO_API_TOKEN=

# Optional reserved slots for Wave-2 live Second-Hand Marketplace APIs (surfaced as live_api_configured only in Wave 1)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
ETSY_KEYSTRING=
ETSY_SHARED_SECRET=
