{
  "name": "shopcart-mcp",
  "version": "0.5.1",
  "mcpName": "io.github.Wals-pro/shopcart-mcp",
  "description": "Agentic Shopping & Cart MCP for Shopify, WooCommerce, Amazon, BigCommerce, Shopware 6, Magento 2, and Universal JSON-LD stores — local stdio OSS CLI and hosted OAuth 2.1 Streamable HTTP server",
  "license": "MIT",
  "type": "module",
  "author": "wals.pro <info@wals.pro>",
  "homepage": "https://shopcart.wals.pro",
  "repository": {
    "type": "git",
    "url": "https://github.com/Wals-pro/shopcart-mcp.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "shopify",
    "ecommerce",
    "shopping",
    "cart",
    "ai-agent",
    "claude",
    "chatgpt",
    "oauth2"
  ],
  "bin": {
    "shopcart-mcp": "./dist/cli.js"
  },
  "main": "./dist/cli.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:mcpb": "node scripts/build-mcpb.mjs",
    "dev:stdio": "tsx src/cli.ts",
    "dev:server": "tsx src/server.ts",
    "start": "node dist/server.js",
    "start:stdio": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@google-cloud/firestore": "^7.11.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "express": "^4.21.2",
    "nodemailer": "^10.6.1",
    "stripe": "^17.7.0",
    "undici": "^7.5.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.0",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^6.0.2",
    "esbuild": "^0.28.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
